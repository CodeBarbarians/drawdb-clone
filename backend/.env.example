SECRET_KEY=change-this-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Switch the DB engine by changing this one value - no code changes needed.
# SQLite (default, good for local dev):
DATABASE_URL=sqlite:///./drawdb_clone.db
# Postgres (e.g. Render's free database - grab the connection string from its dashboard):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
CORS_ORIGINS=http://localhost:5173
